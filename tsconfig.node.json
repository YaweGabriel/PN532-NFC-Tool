{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "outDir": "out",
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": ["electron/**/*", "src/shared/**/*", "src/main/**/*"]
}
